# CSU Attendance Monitoring System -- environment template.
# Copy this file to .env and edit. .env is gitignored and must stay that way.
#
# Defaults below match a stock XAMPP install (MariaDB 10.4, root with no
# password). Change DB_PASSWORD and ADMIN_PASSWORD before any real deployment.

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=csu_attendance

# --- Paths ------------------------------------------------------------------
# Where capture images and evaluation output are written. Relative paths are
# resolved against the project root.
STORAGE_DIR=storage

# --- Application ------------------------------------------------------------
# Gates the admin window, manual entry, and exiting kiosk fullscreen.
ADMIN_PASSWORD=123

# Identifies which kiosk machine wrote a recognition_attempts row.
TERMINAL_NAME=kiosk-01

# --- Anti-spoofing (Phase 9) ------------------------------------------------
# Optional. Leave empty to look in models/anti_spoof/ for the first .onnx file.
# With no model installed the liveness check reports itself unavailable and the
# kiosk keeps recognising people. See app/liveness.py for which model to use.
LIVENESS_MODEL=

# Which output class of that model means "a real person". MiniFASNet returns
# This installed ONNX export scores genuine accepted camera captures as class 2.
LIVENESS_LIVE_CLASS=2
